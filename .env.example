# ── Required ──────────────────────────────────────────────────────────────────

# Name of your rclone remote — must exactly match the name shown by `rclone listremotes`
RCLONE_REMOTE=gdrive

# ── Drive layout ──────────────────────────────────────────────────────────────

# Base folder on Google Drive. Year and month subfolders are appended automatically.
# A file shot in May 2024 lands at: Photos/Camera/2024/05/DSC01234.ARW
DRIVE_BASE_PATH=Photos/Camera

# ── Google Photos (optional) ──────────────────────────────────────────────────

# To send JPEGs to Google Photos instead of Drive, set this to the name of an
# rclone Google Photos remote (create it with `rclone config`, type "Google
# Photos"). When set, .JPG/.JPEG files are uploaded into month albums in Photos
# and RAW files still go to Drive. Leave empty to send everything to Drive.
# GPHOTOS_REMOTE=gphotos

# Album name prefix. A JPEG shot in May 2026 lands in the album "Camera 2026-05".
# GPHOTOS_ALBUM_PREFIX=Camera

# NOTE: The Google Photos API cannot delete media, so JPEGs removed from the
# camera are NOT removed from Photos (their index records are kept to avoid
# re-upload duplicates). Mirror-delete still works for RAW files on Drive.

# ── Local paths ───────────────────────────────────────────────────────────────

# Optional: override the auto-detected DCIM root. Useful if the camera always
# mounts to the same drive letter and you want to skip the WMI detection step.
# Leave commented out to let the service detect it automatically.
# DCIM_PATH_OVERRIDE=E:\DCIM

# Path to the SQLite tracking database (created automatically on first run).
# The parent directory is also created automatically.
DB_PATH=C:\ProgramData\CameraSync\sync.db

# Path to the rotating log file (created automatically on first run).
LOG_PATH=C:\ProgramData\CameraSync\sync.log

# ── Upload mode ───────────────────────────────────────────────────────────────

# Upload strategy. Two modes are available:
#
#   individual  (default) — one rclone subprocess per file, parallelised via
#                           UPLOAD_WORKERS threads. Good for small card sessions.
#
#   batch       — groups files by destination folder and copies each group in a
#                 single rclone call using --files-from. Reduces subprocess
#                 overhead for large sessions. Sequential (no thread pool).
#
# UPLOAD_MODE=individual

# Number of files per rclone invocation when UPLOAD_MODE=batch.
# Ignored in individual mode.
# BATCH_SIZE=10

# Number of parallel upload threads (individual mode only).
# UPLOAD_WORKERS=4

# ── rclone executable ─────────────────────────────────────────────────────────

# Windows Services run in Session 0, which has a minimal PATH that typically
# does not include user-installed tools. Set this to the full path to rclone.exe
# if `rclone` is not available on the system-wide PATH.
# RCLONE_PATH=C:\Program Files\rclone\rclone.exe
